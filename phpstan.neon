includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src
    reportUnmatchedIgnoredErrors: false
    bootstrapFiles:
        - stubs/DebugBar.stub.php
    ignoreErrors:
        -
            identifier: trait.unused
            path: src/Traits/Cacheable.php
